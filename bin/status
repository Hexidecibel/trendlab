#!/usr/bin/env bash
set -euo pipefail
# trendlab runs as a single `docker run` container named `trendlab` on port 9393.
docker ps -a --filter "name=trendlab" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
echo
echo -n "trendlab (9393): "
curl -sS -o /dev/null -w 'HTTP %{http_code}\n' http://localhost:9393/ || echo "unreachable"
